{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scytale",
  "version": "../package.json",
  "identifier": "io.github.abdvlrqhman.scytale",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Scytale",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "pattern": { "use": "isolation", "options": { "dir": "../isolation" } }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Scytale",
    "homepage": "https://github.com/abdvlrqhman/Scytale",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "A free, open-source password manager with no server.",
    "longDescription": "Scytale keeps your passwords in a vault encrypted on your device and syncs it through storage you already own. Nobody else can read it.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NDY0NDU5MjAwNEQzOEUKUldTTzB3UWdXVVJHVnhEelVqcStCd09BVjdBeDRCcUVBVi92Sm10VjEzQjFkdW8xdGRjNE9ibFQK",
      "endpoints": ["https://github.com/abdvlrqhman/Scytale/releases/latest/download/latest.json"]
    }
  }
}
